#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "tap-preferred";
};

&lt { tapping-term-ms = <300>; };

/ {
    behaviors {
        laughing: laughing {
            compatible = "zmk,behavior-tap-dance";
            label = "LAUGHING";
            #binding-cells = <0>;
            bindings = <&hihi>, <&haha>;
        };

        https_http: https_http {
            compatible = "zmk,behavior-tap-dance";
            label = "HTTPS_HTTP";
            #binding-cells = <0>;
            bindings = <&https>, <&http>;
        };

        haizzz_huhu: haizzz_huhu {
            compatible = "zmk,behavior-tap-dance";
            label = "HAIZZZ_HUHU";
            #binding-cells = <0>;
            bindings = <&haizzzz>, <&huhu>;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        hihi: laughing {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp COLON &kp RPAR &kp RPAR &kp RPAR>;
            label = "LAUGHING";
        };

        haha: haha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EQUAL &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR>;
            label = "HAHA";
        };

        yankinVim: yankinVim {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp DQT &kp PLUS &kp Y>;
            label = "YANKINVIM";
        };

        https: https {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp H &kp T &kp T &kp P &kp S &kp COLON &kp FSLH &kp FSLH>;
            label = "HTTPS";
        };

        http: http {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp H &kp T &kp T &kp P &kp COLON &kp FSLH &kp FSLH>;
            label = "HTTP";
        };

        rightarrow: rightarrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp MINUS &kp GT>;
            label = "RIGHTARROW";
        };

        haizzzz: haizzzz {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EQUAL &kp DOT &kp EQUAL>;
            label = "HAIZZZZ";
        };

        huhu: huhu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp COLON &kp LPAR &kp LPAR &kp LPAR &kp LPAR>;
            label = "HUHU";
        };

        leftarrow: leftarrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LT &kp MINUS>;
            label = "LEFTARROW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp ESC           &kp N1     &kp N2    &kp N3    &kp N4        &kp N5    &kp N6    &kp N7          &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB           &kp Q      &kp W     &kp E     &kp R         &kp T     &kp Y     &kp U           &kp I      &kp O     &kp P     &kp LS(PLUS)
&kp ESCAPE        &kp A      &kp S     &kp D     &kp F         &kp G     &kp H     &kp J           &kp K      &kp L     &kp SEMI  &kp BACKSPACE
&kp LEFT_CONTROL  &kp Z      &kp X     &kp C     &kp V         &kp B     &kp N     &kp M           &kp COMMA  &kp DOT   &kp FSLH  &kp LEFT_ALT
                  &kp SPACE  &kp LBKT  &kp RBKT  &kp LEFT_GUI  &kp LALT  &kp LALT  &sk LEFT_SHIFT  &kp LBKT   &kp RBKT  &kp RET
            >;

            sensor-bindings = <&none>, <&none>;
        };

        lower_layer {
            display-name = "Lower Layer";
            bindings = <
&trans  &trans                  &trans          &trans          &trans        &trans           &trans     &trans        &kp SLASH     &kp ASTERISK  &kp MINUS  &trans
&trans  &kp LA(LC(LEFT_SHIFT))  &msc SCRL_LEFT  &msc SCRL_DOWN  &mmv MOVE_UP  &msc SCRL_RIGHT  &trans     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS   &trans
&trans  &trans                  &kp LEFT_ARROW  &kp DOWN        &kp UP_ARROW  &kp RIGHT        &trans     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans     &trans
&trans  &kp PRINTSCREEN         &kp HOME        &kp PAGE_DOWN   &kp PG_UP     &kp END          &kp COMMA  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans     &trans
        &trans                  &trans          &trans          &trans        &trans           &trans     &kp SPACE     &kp NUMBER_0  &kp DOT       &kp RET
            >;

            sensor-bindings =
                <&inc_dec_kp DOWN UP_ARROW>,
                <&inc_dec_kp RIGHT LEFT>;
        };

        raise_layer {
            display-name = "Raise Layer";
            bindings = <
&trans  &trans           &trans       &trans    &trans      &trans       &trans          &trans         &trans            &trans         &trans        &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp GRAVE      &trans        &trans
&trans  &trans           &trans       &trans    &trans      &trans       &kp MINUS       &kp EQUAL      &kp SINGLE_QUOTE  &kp BACKSLASH  &trans        &trans
&trans  &trans           &trans       &trans    &trans      &trans       &kp UNDERSCORE  &kp PLUS       &kp TILDE         &kp PIPE       &kp QUESTION  &kp LC(LA(DEL))
        &trans           &trans       &trans    &trans      &trans       &trans          &trans         &trans            &trans         &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_NEXT C_PREVIOUS>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>,
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
